# AI tools (Groq)
GROQ_API_KEY=

# Public site config
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# "adsense" or "adsterra" — which ad network is live. Adsterra ad unit keys
# are hardcoded in src/components/ads/adsterra-config.ts (not secrets, same
# as the AdSense slot IDs), so no separate env vars are needed for those.
NEXT_PUBLIC_AD_NETWORK=

# Database (Neon Postgres connection string)
DATABASE_URL=

# Admin auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=
# Generate with: node -e "require('bcryptjs').hash(process.argv[1],10).then(console.log)" 'your-password'
ADMIN_PASSWORD_HASH=
